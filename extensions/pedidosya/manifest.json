{
  "manifest_version": 3,
  "name": "Orderhub — PedidosYa Importer",
  "version": "0.1.0",
  "description": "Importa pedidos de PedidosYa Merchant a Orderhub automáticamente",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://*.pedidosya.com/*",
    "https://*.pedidosya.com.ar/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.pedidosya.com/*",
        "https://*.pedidosya.com.ar/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Orderhub"
  },
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": [
        "https://*.pedidosya.com/*",
        "https://*.pedidosya.com.ar/*"
      ]
    }
  ]
}
