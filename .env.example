# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:3001

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=orderhub
POSTGRES_PASSWORD=orderhub_dev
POSTGRES_DB=orderhub
POSTGRES_PORT=5432
DATABASE_URL=postgresql://orderhub:orderhub_dev@localhost:5432/orderhub

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email (Mailpit dev / SMTP prod) ─────────────────────────────────────────
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@orderhub.app

# ─── Storage (LocalStack dev / S3 prod) ──────────────────────────────────────
LOCALSTACK_PORT=4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET=orderhub-dev
AWS_ENDPOINT_URL=http://localhost:4566

# ─── PedidosYa Extension ─────────────────────────────────────────────────────
EXTENSION_API_KEY=dev_extension_key
