FROM node:22-alpine

RUN npm install -g pnpm@9.14.0

# OpenSSL requerido por el engine de Prisma en Alpine
RUN apk add --no-cache openssl

WORKDIR /app

# Instalar dependencias primero (capa cacheada)
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY tsconfig.base.json biome.json ./
COPY packages/types/package.json ./packages/types/
COPY apps/api/package.json ./apps/api/

RUN pnpm install --frozen-lockfile

# Copiar fuentes
COPY packages/types ./packages/types
COPY apps/api ./apps/api

# Build del paquete compartido
RUN pnpm --filter @orderhub/types build

# Generar Prisma client (necesario para que los tipos estén disponibles)
RUN pnpm --filter @orderhub/api db:generate

WORKDIR /app/apps/api

EXPOSE 3000

# Aplica migraciones pendientes y arranca en modo watch
CMD ["sh", "-c", "pnpm db:deploy && pnpm dev"]
